<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>net.avarok.desktop</string>
    <key>CFBundleName</key>
    <string>Avarok</string>
    <key>CFBundleDisplayName</key>
    <string>Avarok</string>
    <key>CFBundleExecutable</key>
    <string>Avarok</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- A menu-bar app: no Dock icon, no menu bar of its own, until a window opens. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Web panels load from http://127.0.0.1:<port>/ only; nothing else is allowed in the clear. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
